generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum FlavorProfile {
  FRUITY
  MENTHOL
  DESSERT
  TOBACCO
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  GCASH
  CARD
}

enum MediaKind {
  PRODUCT_IMAGE
  PAYMENT_PROOF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  media       MediaAsset[]
  orderEvents OrderEvent[] @relation("OrderEventActor")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  barangay      String?
  city          String
  province      String
  postalCode    String
  country       String   @default("PH")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  brand            String
  shortDescription String
  description      String   @db.Text
  categoryId       String
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  @@index([isActive, categoryId])
  @@index([isFeatured, isActive])
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  sku               String         @unique
  label             String
  flavorProfile     FlavorProfile?
  nicotineMg        Int?
  color             String?
  priceCentavos     Int
  stock             Int            @default(0)
  lowStockThreshold Int            @default(5)
  isActive          Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@index([stock])
}

model MediaAsset {
  id           String    @id @default(cuid())
  ownerId      String
  kind         MediaKind
  publicId     String    @unique
  secureUrl    String?
  resourceType String    @default("image")
  width        Int?
  height       Int?
  bytes        Int?
  mimeType     String?
  createdAt    DateTime  @default(now())

  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  productImages   ProductImage[]
  paymentProofFor Order?         @relation("OrderPaymentProof")

  @@index([ownerId, kind])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  mediaId   String   @unique
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  media   MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([variantId])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String
  rating           Int
  title            String
  body             String   @db.Text
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model Order {
  id                      String        @id @default(cuid())
  orderNumber             String        @unique
  userId                  String
  status                  OrderStatus   @default(PENDING)
  paymentMethod           PaymentMethod
  subtotalCentavos        Int
  shippingCentavos        Int
  totalCentavos           Int
  shippingAddress         Json
  contactName             String
  contactEmail            String
  contactPhone            String
  notes                   String?       @db.Text
  paymentReference        String?
  paymentProofId          String?       @unique
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  idempotencyKey          String        @unique
  paidAt                  DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentProof MediaAsset?  @relation("OrderPaymentProof", fields: [paymentProofId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]

  @@unique([paymentMethod, paymentReference])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String
  variantId         String
  productName       String
  variantLabel      String
  sku               String
  unitPriceCentavos Int
  quantity          Int
  lineTotalCentavos Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.Text
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}
