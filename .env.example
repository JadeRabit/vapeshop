# ---------------------------------------------------------------------------
# VapeShop environment template
# Copy to .env for Prisma CLI/seed tooling and local development. Next.js also
# loads .env.local, but Prisma migrations and the seed script read .env.
# Never commit real secrets.
# Values marked [required] must be present before running the full app.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon recommended). DATABASE_URL is the pooled runtime URL;
# DIRECT_URL is the non-pooled URL used by Prisma migrations/seed tooling.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/vapeshop?sslmode=require" # [required]
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/vapeshop?sslmode=require" # [required]

# Auth.js v5. AUTH_SECRET is preferred; NEXTAUTH_SECRET is accepted as a fallback.
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret" # [required]
NEXTAUTH_SECRET="" # [optional fallback]
AUTH_URL="http://localhost:3000" # [optional in local dev; set the canonical URL in production]
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000" # [required for payment redirects/SEO]

# Cloudinary signed uploads. Product images are public; GCash receipts use
# authenticated delivery and are only served through an admin-only route.
CLOUDINARY_CLOUD_NAME="" # [optional for catalog; required for uploads]
CLOUDINARY_API_KEY="" # [optional]
CLOUDINARY_API_SECRET="" # [optional]

# Stripe-hosted Checkout. If these are absent, card payment is disabled.
STRIPE_SECRET_KEY="" # [optional]
STRIPE_WEBHOOK_SECRET="" # [optional]

# Protects /api/cron/expire-orders and (in production) the Vercel cron request.
CRON_SECRET="" # [required in production]

# Idempotent seed. Admin values are required whenever `npm run db:seed` runs;
# rerunning the seed resets this admin's password to SEED_ADMIN_PASSWORD.
SEED_ADMIN_EMAIL="" # [required for seeding]
SEED_ADMIN_PASSWORD="" # [required for seeding, minimum 10 characters]
SEED_ADMIN_NAME="VapeShop Admin" # [optional]

# Opt-in demo catalog/orders. Never enable for a real production database.
SEED_DEMO_DATA="false" # [optional: true/false]

# ---------------------------------------------------------------------------
# Playwright-only variables (not read by the application).
# Credentials default to the seeded admin and demo customer when available.
# Set E2E_CUSTOMER_* when E2E runs against a non-demo database.
# ---------------------------------------------------------------------------
# E2E_ADMIN_EMAIL=""
# E2E_ADMIN_PASSWORD=""
# E2E_CUSTOMER_EMAIL=""
# E2E_CUSTOMER_PASSWORD=""
# PLAYWRIGHT_BASE_URL="http://localhost:3000"
